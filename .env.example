# .env.example — BAN PHAT HANH cho khach hang (Phase 5 cua ke hoach dong goi,
# plans/260923-1504-dong-goi-docker-ban-khach-hang-khong-anh-huong-bot-dang-test).
#
# KHAC ban .env.example cu (danh cho dev): da xoa toan bo bien "chet" (khong
# con service nao doc - DEEPSEEK_*, MEMORY_URL, TOOLS_URL, AUDIT_URL,
# OWNER_UIDS, IMAGE_BASE_URL/IMAGE_API_KEY/IMAGE_MODEL cu, TTS_*,
# REDIS_QUEUE_URL/REDIS_SESSION_URL, OBSIDIAN_VAULT_PATH — kien truc cu da
# thay the boi Hermes Agent, cac bien nay khong con service nao doc, xem
# reports/phase-03-audit-report.md muc 3). Doi gia tri mac dinh KHONG an
# toan cho production: ZALO_CLI_MODE tu "mock" -> "real", COOKIE_SECURE tu
# "false" -> "true" (Phase 6 da chot: Dashboard mo cong truc tiep ra
# internet). Bo sung ZALO_ALLOWED_USERS (truoc day bi thieu hoan toan).
#
# install.sh (Phase 6) TU DONG dien file nay - khach hang KHONG can tu sua
# tay. Neu anh (nguoi ban) dang cai dat thu cong de test, dien theo huong
# dan comment o moi dong.

# ===== BAT BUOC - install.sh hoi khach luc cai dat, KHONG co gia tri mac dinh an toan =====
# Ten hien thi THAT cua bot tren Zalo (dung de bot tu huong dan "@<ten bot>").
BOT_NAME=
# Mat khau dang nhap Dashboard - install.sh tu sinh ngau nhien du manh (>=16
# ky tu) neu khach khong tu dat.
DASHBOARD_PASSWORD=
# UID Zalo cua CHINH CHU BOT - GIOI HAN quyen dung lenh nguy hiem (terminal,
# quan tri, du lieu MAT). KHONG duoc de trong/mac dinh mo - xem Phase 3 audit
# muc "Quyet dinh pham vi phuc vu". Lay qua wizard Phase 7 SAU khi bot da
# nhan duoc 1 tin nhan dau tien (khach khong the biet UID truoc luc cai).
ZALO_ALLOWED_USERS=

# ===== TU SINH boi install.sh (openssl rand) - KHONG dung chung giua cac khach hang =====
INTERNAL_API_TOKEN=
ZALO_SCOPED_TOKEN=
CONFIDENTIAL_TICKET_SECRET=
REDIS_PASSWORD=
DASHBOARD_SESSION_SECRET=
# Khoa AES-256-GCM ma hoa credentials Zalo tai nghi (services/gateway/
# credentials.js) - MOI khach 1 khoa rieng. Doi khoa nay sau khi da co du
# lieu se lam MAT vinh vien phien dang nhap Zalo da luu - install.sh KHONG
# duoc sinh de neu file .env da ton tai (xem Phase 6 sua loi idempotent).
CREDENTIALS_ENC_KEY=
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes_internal
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# ===== San PRODUCTION - KHONG doi (khac gia tri mac dinh cua ban dev) =====
# "real" = ket noi Zalo that. "mock" CHI danh cho dev noi bo, KHONG duoc
# dung cho khach hang (bot se khong bao gio nhan tin nhan that neu de mock).
ZALO_CLI_MODE=real
# [Sua 2026-09-24, phat hien qua Phase 8 test that] BAT BUOC "false" - Phase
# 6 da chot Dashboard mo cong TRUC TIEP qua HTTP thuong (KHONG co TLS/HTTPS,
# xem Validation Log trong plan.md: "mo cong + tuong lua + mat khau manh",
# khong dung SSH tunnel/Cloudflare Tunnel). Cookie "Secure" CHI duoc trinh
# duyet gui lai qua ket noi HTTPS - dat "true" ma khong co HTTPS khien trinh
# duyet AM THAM khong luu lai phien dang nhap, khach dang nhap xong bi bat
# nguoc ve trang login ngay lap tuc, KHONG THE dung duoc Dashboard. Chi doi
# lai "true" NEU sau nay Dashboard duoc dat sau 1 domain rieng co TLS that.
COOKIE_SECURE=false
# Lop phong thu thu 2 chan duong leo thang quyen qua config.yaml (Phase 3
# audit finding #9/#3) - entrypoint.sh (da bake vao image) cung tu ep lai
# gia tri nay moi lan khoi dong du phia nao ghi de.
GATEWAY_ALLOW_ALL_USERS=false

# ===== Tuy chon - khach TU DIEN qua Dashboard SAU khi cai xong (Phase 7 wizard), de trong luc cai =====
# Tran chi tieu AI/ngay (USD) - de trong hoac 0 = tat, khong tu gioi han.
SPEND_CAP_DAILY_USD=0
# API key mo hinh AI chinh (OpenRouter) - khach tu nhap qua Dashboard trang
# "Cong cu AI" SAU khi cai xong, KHONG bat buoc luc cai dat.
OPENROUTER_API_KEY=
# API key tim kiem web (Tavily) - tuy chon, khach tu nhap qua Dashboard.
TAVILY_API_KEY=
# Model tao anh AI qua OpenRouter - tuy chon, khach tu chon qua Dashboard.
OPENROUTER_IMAGE_MODEL=
